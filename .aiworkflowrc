# What the dev pipeline reads about this project.
# Schema: ${CLAUDE_PLUGIN_ROOT}/docs/project-contract.md

spec_repo = "../SonosControllerSpecs"
design_philosophy = "docs/change-discipline.md"

[test_phase]
# Local verification, then the push: this repo's only deployment is production
# and there is no dev instance to roll. The doc runs the suites and the dev
# stack here, then pushes — and that push is the production deploy.
strategy = "docs/slice-test-plan.md"

[doc_phase]
plan = "docs/slice-doc-plan.md"

[push]
enabled = true
# The push is the production deploy (Jenkins builds, pins, Argo CD syncs prd).
deploys = true

# No [devlock]: with no dev instance, nothing contends over one.

[migrations]
paths = ["backend/alembic/versions/*.py"]
# uv lives in the python sidecar, not on the dev container's PATH.
check = "cd backend && test \"$(cexec python uv run alembic heads | wc -l)\" -eq 1"
